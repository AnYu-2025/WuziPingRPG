<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/previewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="90dp"
        android:layout_marginBottom="80dp" />

    <Spinner
        android:id="@+id/previewMode"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:backgroundTint="#FFFFFF"
        android:contentDescription="@string/preview_effect" />

    <TextView
        android:id="@+id/previewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="22dp"
        android:background="#66000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/closeBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/close"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingBottom="18dp"
        android:orientation="horizontal">
        <Button android:id="@+id/editCropBtn" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/edit_crop" />
        <Button android:id="@+id/editRotateBtn" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/rotate" />
        <Button android:id="@+id/editRestoreBtn" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/restore_original" />
        <Button android:id="@+id/deleteBtn" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/delete_page" />
    </LinearLayout>
</FrameLayout>
