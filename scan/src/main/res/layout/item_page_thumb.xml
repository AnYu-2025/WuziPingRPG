<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbImage"
        android:layout_width="62dp"
        android:layout_height="82dp"
        android:background="#22FFFFFF"
        android:contentDescription="@string/page_preview"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Thumb" />

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:alpha="0.75"
        android:contentDescription="@string/reorder_hint"
        android:src="@drawable/ic_grip"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/pageNumber"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/page_badge_bg"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />
</FrameLayout>
