<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.scan.camera.PageFrameOverlay
        android:id="@+id/pageFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <com.scan.camera.ZoomDialView
        android:id="@+id/zoomDial"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/top_scrim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- 并入天工后的返回入口：结束扫描页，回到天工首页（系统返回键效果相同） -->
            <TextView
                android:id="@+id/homeBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/back_to_studio"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/torchBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/torch_off"
                android:padding="8dp"
                android:src="@drawable/ic_flash"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/postBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/content_post"
                android:padding="7dp"
                android:src="@drawable/ic_post"
                app:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/correctChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/correct"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ocrChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/ocr"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/frameChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/frame"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/autoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/content_auto"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/auto"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hintEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="@string/hint_empty"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/modeColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_bg"
                    android:paddingHorizontal="13dp"
                    android:paddingVertical="6dp"
                    android:text="@string/mode_color"
                    android:textColor="@color/chip_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/modeGray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/chip_bg"
                    android:paddingHorizontal="13dp"
                    android:paddingVertical="6dp"
                    android:text="@string/mode_gray"
                    android:textColor="@color/chip_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/modeBw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/chip_bg"
                    android:paddingHorizontal="13dp"
                    android:paddingVertical="6dp"
                    android:text="@string/mode_bw"
                    android:textColor="@color/chip_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/thumbStrip"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/importBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/import_photo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/clearBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/clear"
                    android:textColor="#FF8A80"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_delete"
                    app:drawableTint="#FF8A80" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/shutterBtn"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/shutter_bg" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/pdfBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pdf_btn_bg"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="11dp"
                    android:text="@string/make_pdf_count_empty"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#E6101418"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/cancel"
            android:visibility="gone"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#E6101418"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_permission_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/retryBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pdf_btn_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/grant_camera"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/openSettingsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/open_settings"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
